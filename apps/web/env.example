# =============================================================================
# MAKSY WEB APPLICATION - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!

# =============================================================================
# CLERK AUTHENTICATION (Required)
# =============================================================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase project credentials (for storage, realtime, etc.)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# STRIPE PAYMENTS (Required for billing)
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe webhook secret (from webhook endpoint settings)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs for subscription plans
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxx
STRIPE_SCALE_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_SCALE_YEARLY_PRICE_ID=price_xxxxx
STRIPE_TEAM_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_TEAM_YEARLY_PRICE_ID=price_xxxxx
STRIPE_TEAM_SEAT_PRICE_ID=price_xxxxx

# =============================================================================
# EMAIL (Required for notifications)
# =============================================================================
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx

# Default sender email (must be from verified domain)
EMAIL_FROM="Maksy <noreply@yourdomain.com>"

# =============================================================================
# SMS (Optional - for SMS notifications)
# =============================================================================
# Twilio credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# AI FEATURES (Required for AI features)
# =============================================================================
# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# =============================================================================
# BACKGROUND JOBS (Required for automations)
# =============================================================================
# Inngest keys from https://app.inngest.com
INNGEST_EVENT_KEY=xxxxx
INNGEST_SIGNING_KEY=signkey-xxxxx

# =============================================================================
# ERROR TRACKING (Recommended for production)
# =============================================================================
# Sentry DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxx

# =============================================================================
# GOOGLE MAPS (Required for GPS tracking)
# =============================================================================
# Google Maps API key with Maps JavaScript API enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyxxxxx

# =============================================================================
# APPLICATION URLs
# =============================================================================
# Your application URL (used for webhooks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# QuickBooks OAuth (for accounting integration)
# QUICKBOOKS_CLIENT_ID=xxxxx
# QUICKBOOKS_CLIENT_SECRET=xxxxx

# Google Business Profile (for reviews)
# GOOGLE_BUSINESS_CLIENT_ID=xxxxx
# GOOGLE_BUSINESS_CLIENT_SECRET=xxxxx

